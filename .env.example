# Runtime
NODE_ENV=development
PORT=5000

# Public application URLs 
# CLIENT_URL is used for CORS, Paystack callbacks, buyer magic links, and order links.
CLIENT_URL=http://localhost:5173
# Production HTTPS origin of this API, used to register Telegram webhooks.
# Leave blank only when using local long polling.
API_PUBLIC_URL=https://your-production-api-url.com

# Required persistence and authentication
MONGO_URI=mongodb://127.0.0.1:27017/chatstand
JWT_SECRET=replace_with_a_long_random_secret

# Brevo transactional email
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=Your Store Platform

# Cloudinary product media
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Optional AI agent provider (the deterministic commerce agent works without it)
# Currently using deterministic agent, so no need for OpenAI API key
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Paystack server-side payments and payouts
PAYSTACK_SECRET_KEY=

# Telegram bot tokens and webhook secrets are connected per seller through
# POST /api/telegram/connect and must not be stored in this file.


# Platform Fee Defaults
PLATFORM_FEE_PERCENTAGE=5
PLATFORM_FEE_FIXED=0