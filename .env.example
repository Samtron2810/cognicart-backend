# Runtime
NODE_ENV=development
PORT=5000

# Public application URLs 
# CLIENT_URL is used for CORS, Paystack callbacks, buyer magic links, and order links.
CLIENT_URL=http://localhost:5173
# Production HTTPS origin of this API, used to register Telegram webhooks.
# Leave blank only when using local long polling.
API_PUBLIC_URL=https://your-production-api-url.com

# Required persistence and authentication
MONGO_URI=mongodb://127.0.0.1:27017/chatstand
# Required. No code-level default exists: the server refuses to boot without it.
# Signs all session tokens AND keys the HMAC for OTP / password-reset /
# magic-link tokens, so changing it invalidates every active session and every
# pending code. Use 32+ characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=replace_with_a_long_random_secret

# Brevo transactional email
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=Your Store Platform

# Cloudinary product media
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Optional AI agent provider (the deterministic commerce agent works without it)
# Currently using deterministic agent, so no need for OpenAI API key
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Paystack server-side payments and payouts
PAYSTACK_SECRET_KEY=

# Telegram bot tokens and webhook secrets are connected per seller through
# POST /api/telegram/connect and must not be stored in this file.


# Platform Fee Defaults
PLATFORM_FEE_PERCENTAGE=5
PLATFORM_FEE_FIXED=0

# Seller ranking job (added in Phase 1)
# Recomputes every seller's directory ranking score. Runs in-process behind a
# MongoDB lease lock, so several API instances will not run it several times.
# Values below are the built-in defaults: the job works with none of them set.
# Set RANKING_JOB_ENABLED=false to hand the job to an external cron instead,
# pointed at POST /api/admin/ranking/recompute.
RANKING_JOB_ENABLED=true
# How often the recompute runs. 3600000ms = 1 hour.
RANKING_JOB_INTERVAL_MS=3600000
# Delay after boot before the first run, so it does not compete with startup.
RANKING_JOB_INITIAL_DELAY_MS=60000